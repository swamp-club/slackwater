# Copy to .env and fill in. Never commit .env.

# Slack: the bot token (xoxb-...) and the app-level token for Socket Mode (xapp-..., scope connections:write).
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Serve: its HTTP base URL, and the integration credential printed once by
# `swamp access integration register` (swi1....).
SWAMP_SERVE_URL=https://serve.example.internal:9090
SWAMP_INTEGRATION_CREDENTIAL=

# The local store: a folder for tokens and watched runs, and the key that encrypts them.
# Make a key with: openssl rand -base64 32
SLACKWATER_STATE_DIR=./state
SLACKWATER_STORE_KEY=
