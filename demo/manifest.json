{
  "display_information": {
    "name": "Swamp",
    "description": "Run swamp workflows as yourself, and approve their gates.",
    "background_color": "#2f4f3a"
  },
  "features": {
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": true
    },
    "bot_user": {
      "display_name": "slackwater",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/slackwater",
        "description": "Link your swamp account, or run a workflow",
        "usage_hint": "link | status | run <workflow> [name=value …] | unlink",
        "should_escape": false
      },
      {
        "command": "/scale-web",
        "description": "Change how many web servers are running",
        "usage_hint": "opens a form",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "commands",
        "chat:write",
        "users:read",
        "users:read.email"
      ]
    }
  },
  "settings": {
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
