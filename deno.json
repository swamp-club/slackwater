{
  "tasks": {
    "check": "deno check src/ test/ scripts/",
    "test": "deno test --allow-net --allow-read --allow-write --allow-env",
    "ci": "deno fmt --check && deno lint && deno task check && deno task test",
    "secrets": "gitleaks git --redact --no-banner . && gitleaks dir --redact --no-banner .",
    "hooks": "git config core.hooksPath .githooks",
    "start": "deno run --env-file=.env --allow-net --allow-env --allow-read --allow-write=state,./state src/main.ts",
    "manifest": "deno run --allow-read --allow-env scripts/manifest.ts"
  },
  "fmt": {
    "lineWidth": 100
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  },
  "exclude": [
    "state/",
    "coverage/"
  ],
  "imports": {
    "@slack/bolt": "npm:@slack/bolt@^4.7.3",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/yaml": "jsr:@std/yaml@^1.3.0"
  }
}
